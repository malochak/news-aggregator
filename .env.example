# --- Required -------------------------------------------------------------
# Any Postgres works: local, Docker, Neon, Supabase (use the pooled URL on serverless).
DATABASE_URL=postgres://feedlist:feedlist@localhost:5432/feedlist
# Public URL of this instance.
BETTER_AUTH_URL=http://localhost:3000
# Random 32+ char string. Signs sessions and encrypts users' AI keys.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Protects /api/cron. Send as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Scheduling -----------------------------------------------------------
# On a long-running server (VPS/Docker) set to true to fetch feeds in-process
# every FETCH_INTERVAL_MINUTES. On Vercel leave false and call /api/cron.
INTERNAL_CRON=false
FETCH_INTERVAL_MINUTES=30

# --- Sign-up --------------------------------------------------------------
# Set to false on a personal instance once your account exists.
ALLOW_SIGNUP=true
# Optional GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Instance-wide default AI (optional) ----------------------------------
# Used for users who have not configured their own key. Leave empty on a
# shared instance so everyone brings their own key.
# Providers: anthropic | openai | mistral | xai | google | openai-compatible
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Only for openai-compatible (Ollama, vLLM, LM Studio, OpenRouter, ...)
AI_BASE_URL=

# --- Email (daily digest) -------------------------------------------------
SMTP_URL=
# e.g. "Feedlist <digest@example.com>"
EMAIL_FROM=

# --- Optional: X/Twitter via a self-hosted RSSHub ---------------------------
RSSHUB_URL=

# --- Network --------------------------------------------------------------
# Feeds, articles and AI base URLs on private/loopback addresses are refused so
# users of a shared instance can't reach the server's network. Set to true on a
# personal instance to use e.g. a local Ollama (http://localhost:11434/v1).
ALLOW_PRIVATE_NETWORK=false
